# Counter kumulatif voucher hotspot.
# check_name membaca Max-All-Session dari radgroupcheck.
# reply_name mengisi Session-Timeout di jawaban dengan sisa waktu.
sqlcounter hotspot_time {
	sql_module_instance = sql
	dialect = mysql

	counter_name = Max-All-Session
	check_name = Max-All-Session
	reply_name = Session-Timeout

	key = User-Name
	reset = never

	query = "\
		SELECT IFNULL(SUM(acctsessiontime), 0) \
		FROM radacct \
		WHERE username='%{${key}}'"
}
